# Jangan tampilkan daftar isi folder yang tidak punya index (upload, load/, Image/, ...). Hanya berlaku untuk
# aplikasi ini; <Directory /var/www/> di apache2.conf tetap Options Indexes untuk aplikasi lain (2026-11-05).
Options -Indexes

# Tolak akses ke file backup editor / salinan lama.
# Apache menampilkan file ini sebagai teks biasa (kode sumber & password database ikut terbaca).
<FilesMatch "(~|\.bak|\.old|\.orig|\.save|\.swp|\.sql|\.md)$">
    Require all denied
</FilesMatch>

# Arsip (.zip/.rar/.7z/.tar/.gz) berisi kode sumber atau data, tidak untuk diunduh lewat web.
<FilesMatch "\.(zip|rar|7z|tar|gz|tgz)$">
    Require all denied
</FilesMatch>

# Proses EOD yang dijalankan cron lewat php CLI (crontab server, 2026-11-03); tidak boleh dipicu lewat web
# karena menjalankan ulang di hari yang sama mencatat potongan/jurnal ganda.
<FilesMatch "^(proses_eod_debet_rest|proses_eod_realisasi_wakal|proses_eod_realisasi_murab|proses_eod_ppap)\.php$">
    Require all denied
</FilesMatch>

# Folder/file berawalan titik (.git, .gitignore, .vscode, .env, ...) di mana pun: riwayat git berisi seluruh kode
# sumber termasuk password lama. Dicek lewat URI karena FilesMatch tidak mengenai isi folder (2026-11-05).
<If "%{REQUEST_URI} =~ m#/\.(?!well-known/)#">
    Require all denied
</If>

# Kredensial database server (lihat koneksi_db.php); tidak boleh dibuka langsung.
<Files "koneksi_db.lokal.php">
    Require all denied
</Files>
